# Auto detect text files and perform LF normalization
* text=auto

# text=auto still hands a Windows checkout CRLF, and a CR makes bash fail with "$'\r': command not found".
*.sh    text eol=lf
*.bash  text eol=lf

# Windows-only scripts stay CRLF-friendly; they never run under bash.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
